topics = [
  {
    key = "dup.topic"
    locale = "en"
    title = "First"
    meta { audience = AUDIENCE_PUBLIC }
    body { blocks = [{ paragraph { runs = [{ text = "One." }] } }] }
    review { state = REVIEW_STATE_DRAFT author = "a@example.com" }
  }
  {
    key = "dup.topic"
    locale = "en"
    title = "Second"
    meta { audience = AUDIENCE_PUBLIC }
    body { blocks = [{ paragraph { runs = [{ text = "Two." }] } }] }
    review { state = REVIEW_STATE_DRAFT author = "a@example.com" }
  }
]