topics = [
  {
    key = "bad.descriptor_path"
    locale = "en"
    title = "Descriptor path that is not in the source map"
    meta { audience = AUDIENCE_PUBLIC }
    anchors = [
      {
        descriptor_path {
          element_fqn = "fixtures.basic.User.email"
          annotation_fqn = "protowire.schema.v1.validate"
          ordinal = 7
        }
      }
    ]
    body { blocks = [{ paragraph { runs = [{ text = "Body." }] } }] }
    review { state = REVIEW_STATE_DRAFT author = "a@example.com" }
  }
]